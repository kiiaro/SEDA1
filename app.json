{
  "expo": {
    "name": "theSEDA",
    "slug": "seda",
    "version": "1.6.1",
    "scheme": "seda",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#04B78D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kiiaro.seda1"
    },
    "android": {
      "package": "com.kiiaro.seda1",
      "versionCode": 8,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#04B78D"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Permita que o theSEDA leia o QR de conexão com seu profissional.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
